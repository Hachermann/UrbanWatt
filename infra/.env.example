# Modèle de configuration : copier ce fichier en .env, puis remplacer les valeurs.
# Le fichier .env est ignoré par Git : les mots de passe ne sont jamais commités.
#
# Si vous changez POSTGRES_USER ou POSTGRES_DB, reportez la valeur dans
# infra/pgadmin/servers.json (Username, MaintenanceDB).

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=UrbanWatt
POSTGRES_PORT=5432

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changez-moi
PGADMIN_PORT=5050
